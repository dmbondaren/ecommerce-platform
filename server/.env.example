NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# PostgreSQL (matches docker-compose.yml when the API runs on the host)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# Origin of the web client, used for CORS and for links in e-mails
CLIENT_URL=http://localhost:5173

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-32+-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Optional. Without SMTP the API logs outgoing e-mails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Marketplace <no-reply@example.com>

# Optional. Creates (or promotes) this account as super admin on startup.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Simulated payments: transfer details shown to buyers, and how long a reservation lasts.
PAYMENT_RECIPIENT=Marketplace Escrow (demo)
PAYMENT_IBAN=CH93 0076 2011 6238 5295 7
PAYMENT_WINDOW_MINUTES=15

# Deployment options (see README, "Deploying"). Leave unset for local development.
# STORAGE_DRIVER=database
# CLIENT_DIST=public
# AUTO_VERIFY_EMAIL=true
# SEED_DEMO_DATA=true

# E-mail over HTTPS (https://www.brevo.com), for hosts that block SMTP ports. MAIL_FROM must be a sender verified there.
# BREVO_API_KEY=
# DEMO_OWNER_EMAIL=you@example.com
